{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sapphirus:bmad100:task-result:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "commit",
    "source_hashes",
    "files_changed",
    "commands",
    "acceptance",
    "blockers",
    "evidence_hashes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "complete",
        "failed",
        "blocked"
      ]
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "cwd",
          "exit_code",
          "started_at",
          "ended_at",
          "log"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "started_at": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          },
          "log": {
            "type": "string"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "passed",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
