  "inputs": {
    "config": "{project-root}/_bmad/bmm/config.yaml",
    "customization": [
      "{skill-root}/customize.toml",
      "{project-root}/_bmad/custom/bmad-check-implementation-readiness.toml",
      "{project-root}/_bmad/custom/bmad-check-implementation-readiness.user.toml"
    ]
  },
  "outputs": {
    "outputLocations": ["planning_artifacts"],
    "artifact": "{planning_artifacts}/implementation-readiness-report-{date}.md",
