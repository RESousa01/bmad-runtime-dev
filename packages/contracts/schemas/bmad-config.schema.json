{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sapphirus.dev/v1/bmad-config.schema.json",
  "title": "sapphirus.bmad-config.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "configId", "layers", "resolvedHash", "provenanceHash"],
  "properties": {
    "schemaVersion": { "const": "sapphirus.bmad-config.v1" },
    "configId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/ConfigLayer" }
    },
    "resolvedHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
    "provenanceHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
  },
  "$defs": {
    "ConfigLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ordinal", "contentHash"],
      "properties": {
        "kind": { "enum": ["central", "bundled_module", "project", "user", "invocation"] },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 4 },
        "contentHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
      }
    }
  }
}
