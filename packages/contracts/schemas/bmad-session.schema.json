{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sapphirus.dev/v1/bmad-session.schema.json",
  "title": "sapphirus.bmad-session.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "capabilityId", "mode", "agentProfile", "state", "version", "identities", "evidenceHash", "control", "artifacts", "evidence"],
  "properties": {
    "schemaVersion": { "const": "sapphirus.bmad-session.v1" },
    "sessionId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "capabilityId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "mode": { "enum": ["interactive", "headless"] },
    "agentProfile": { "enum": ["stateless", "memory", "autonomous_pulse"] },
    "state": { "enum": ["created", "resolving", "input_required", "ready", "running", "awaiting_approval", "paused", "validating", "completed", "failed", "cancelled"] },
    "version": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "identities": { "$ref": "#/$defs/SessionIdentities" },
    "evidenceHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
    "control": { "$ref": "#/$defs/SessionControl" },
    "stage": { "type": "string", "minLength": 1, "maxLength": 256 },
    "action": { "type": "string", "minLength": 1, "maxLength": 256 },
    "inputRequest": { "$ref": "#/$defs/InputRequest" },
    "approvalRequest": { "$ref": "#/$defs/ApprovalRequest" },
    "answers": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/RecordedAnswer" }
    },
    "modelCalls": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/ModelCall" }
    },
    "toolProposals": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/ToolProposal" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "./common.schema.json#/$defs/ContractId" }
    },
    "completionHooks": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/CompletionHook" }
    },
    "outcome": { "$ref": "#/$defs/Outcome" },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "./common.schema.json#/$defs/Sha256" }
    }
  },
  "$defs": {
    "SessionIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "packageId", "configHash", "customizationHash", "modelId", "taskId", "workspaceId", "policyHash"],
      "properties": {
        "sourceId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "packageId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "configHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "customizationHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "modelId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "taskId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "workspaceId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "policyHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
      }
    },
    "SessionControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pauseAllowed", "resumeAllowed", "cancelAllowed"],
      "properties": {
        "pauseAllowed": { "type": "boolean" },
        "resumeAllowed": { "type": "boolean" },
        "cancelAllowed": { "type": "boolean" }
      }
    },
    "InputRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "prompt", "responseSchemaHash"],
      "properties": {
        "requestId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "responseSchemaHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
      }
    },
    "ApprovalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "planHash", "effectClass"],
      "properties": {
        "requestId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "planHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "effectClass": { "enum": ["filesystem", "process", "network", "installation", "publication", "schedule", "secret"] }
      }
    },
    "RecordedAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "answerHash"],
      "properties": {
        "requestId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "answerHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
      }
    },
    "ModelCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "modelId", "requestHash", "responseHash"],
      "properties": {
        "callId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "modelId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "requestHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "responseHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
      }
    },
    "ToolProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "planHash", "status"],
      "properties": {
        "proposalId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "planHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "status": { "enum": ["proposed", "approved", "rejected", "expired"] }
      }
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code"],
      "properties": {
        "kind": { "enum": ["completed", "failed", "cancelled"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "CompletionHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "enabled"],
      "properties": {
        "hook": { "enum": ["persist_artifacts", "emit_receipt", "notify_local", "schedule_followup"] },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
