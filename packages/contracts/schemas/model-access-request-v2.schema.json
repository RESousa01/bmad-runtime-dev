{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sapphirus.dev/v1/model-access-request-v2.schema.json",
  "title": "sapphirus.model-access-request-v2.v1",
  "description": "The second version of the desktop model access request. Version two names an organization profile and a catalog version instead of a single fixed provider profile, and it separates the document version from the schema major: the wire discriminator is desktop-model-access-request.v2 while the schema family stays at major one. Foundry authority is unrepresentable here. There is no property that can carry a project endpoint, a deployment name, an API version, a provider SDK option, a credential, or a bearer token, so the desktop cannot select or influence the deployment the support plane resolves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "deliveryModel",
    "registrationId",
    "purpose",
    "modelRole",
    "requestMode",
    "modelProfileId",
    "requestedVariantId",
    "catalogVersion",
    "modelProfileHash",
    "modelCapabilityHash",
    "contextSnapshotId",
    "canonicalOutputSchemaId",
    "canonicalOutputSchemaHash",
    "localEgressManifestHash",
    "consent",
    "items",
    "tools",
    "retentionMode",
    "budgetClass"
  ],
  "properties": {
    "schemaVersion": { "const": "desktop-model-access-request.v2" },
    "requestId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "deliveryModel": { "const": "windows_local" },
    "registrationId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 64 },
    "modelRole": { "type": "string", "minLength": 1, "maxLength": 64 },
    "requestMode": { "$ref": "./model-profile.schema.json#/$defs/ModelRequestMode" },
    "modelProfileId": { "$ref": "./model-profile.schema.json#/$defs/ModelProfileId" },
    "requestedVariantId": {
      "description": "The operating point the user selected within the profile. Null asks the support plane to apply the profile default variant.",
      "oneOf": [
        { "$ref": "./model-profile.schema.json#/$defs/ModelVariantId" },
        { "type": "null" }
      ]
    },
    "catalogVersion": { "$ref": "./model-catalog.schema.json#/$defs/CatalogVersion" },
    "modelProfileHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
    "modelCapabilityHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
    "contextSnapshotId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "canonicalOutputSchemaId": {
      "description": "The canonical output schema a structured response must satisfy. Null in streaming chat mode, where no structured output is produced.",
      "oneOf": [
        { "$ref": "#/$defs/CanonicalSchemaId" },
        { "type": "null" }
      ]
    },
    "canonicalOutputSchemaHash": {
      "oneOf": [
        { "$ref": "./common.schema.json#/$defs/Sha256" },
        { "type": "null" }
      ]
    },
    "localEgressManifestHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
    "consent": { "$ref": "#/$defs/ModelContextConsentV2" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/ModelContextItem" }
    },
    "tools": {
      "description": "Tools the model may call. A tool declares a canonical parameter schema identifier and hash rather than an inline provider parameter document, so a request cannot smuggle a provider-shaped payload through a tool definition.",
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/ModelToolDefinition" }
    },
    "retentionMode": { "const": "transient_no_store" },
    "budgetClass": { "type": "string", "minLength": 1, "maxLength": 64 }
  },
  "$defs": {
    "CanonicalSchemaId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
    },
    "Region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "ModelToolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "ModelContextItem": {
      "description": "One approved context item. Identical in shape to the version one context item, so the version one adapter can lift an existing item without reshaping it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientItemId",
        "relativeLabel",
        "semanticRole",
        "language",
        "contentHash",
        "byteCount",
        "classification",
        "content"
      ],
      "properties": {
        "clientItemId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "relativeLabel": { "$ref": "./common.schema.json#/$defs/RelativeWorkspacePath" },
        "semanticRole": { "type": "string", "minLength": 1, "maxLength": 64 },
        "language": { "type": "string", "minLength": 1, "maxLength": 64 },
        "contentHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "content": { "type": "string", "maxLength": 4194304 }
      }
    },
    "ModelToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolName",
        "description",
        "parametersSchemaId",
        "parametersSchemaHash"
      ],
      "properties": {
        "toolName": { "$ref": "#/$defs/ModelToolName" },
        "description": { "type": "string", "minLength": 1, "maxLength": 256 },
        "parametersSchemaId": { "$ref": "#/$defs/CanonicalSchemaId" },
        "parametersSchemaHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
      }
    },
    "ConsentInstallationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proofType",
        "algorithm",
        "keyId",
        "signedPayloadHash",
        "signature"
      ],
      "properties": {
        "proofType": { "const": "installation_signature" },
        "algorithm": { "const": "ES256" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signedPayloadHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "signature": {
          "type": "string",
          "minLength": 16,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "ModelContextConsentV2": {
      "description": "The signed context decision for a version two request. It drops the deployment hash the version one decision carried, because the desktop no longer knows or chooses a deployment, and it adds the profile, catalog epoch, requested variant, request mode, and context snapshot. Changing the profile, the catalog epoch, the variant, the canonical output schema, the context snapshot, or the request mode therefore produces a decision that no longer matches the request it is presented with.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decisionId",
        "requestId",
        "invocationId",
        "deliveryModel",
        "tenantHash",
        "subjectHash",
        "registrationId",
        "installationPublicKeyHash",
        "entitlementLeaseId",
        "entitlementLeaseHash",
        "tenantPolicyId",
        "tenantPolicyVersion",
        "tenantPolicyHash",
        "purpose",
        "modelRole",
        "requestMode",
        "modelProfileId",
        "requestedVariantId",
        "catalogVersion",
        "contextSnapshotId",
        "canonicalOutputSchemaId",
        "canonicalOutputSchemaHash",
        "manifestHash",
        "invocationBindingHash",
        "consumptionHash",
        "consentDisclosureHash",
        "providerProfileHash",
        "modelProfileHash",
        "modelCapabilityHash",
        "region",
        "retentionMode",
        "budgetClass",
        "issuedAt",
        "notBefore",
        "expiresAt",
        "nonceHash",
        "consentEnvelopeHash",
        "proof"
      ],
      "properties": {
        "schemaVersion": { "const": "sapphirus.model-context-consent.v2" },
        "decisionId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "requestId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "invocationId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "deliveryModel": { "const": "windows_local" },
        "tenantHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "subjectHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "registrationId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "installationPublicKeyHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "entitlementLeaseId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "entitlementLeaseHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "tenantPolicyId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "tenantPolicyVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tenantPolicyHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 64 },
        "modelRole": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requestMode": { "$ref": "./model-profile.schema.json#/$defs/ModelRequestMode" },
        "modelProfileId": { "$ref": "./model-profile.schema.json#/$defs/ModelProfileId" },
        "requestedVariantId": {
          "oneOf": [
            { "$ref": "./model-profile.schema.json#/$defs/ModelVariantId" },
            { "type": "null" }
          ]
        },
        "catalogVersion": { "$ref": "./model-catalog.schema.json#/$defs/CatalogVersion" },
        "contextSnapshotId": { "$ref": "./common.schema.json#/$defs/ContractId" },
        "canonicalOutputSchemaId": {
          "oneOf": [
            { "$ref": "#/$defs/CanonicalSchemaId" },
            { "type": "null" }
          ]
        },
        "canonicalOutputSchemaHash": {
          "oneOf": [
            { "$ref": "./common.schema.json#/$defs/Sha256" },
            { "type": "null" }
          ]
        },
        "manifestHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "invocationBindingHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "consumptionHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "consentDisclosureHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "providerProfileHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "modelProfileHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "modelCapabilityHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "region": { "$ref": "#/$defs/Region" },
        "retentionMode": { "const": "transient_no_store" },
        "budgetClass": { "type": "string", "minLength": 1, "maxLength": 64 },
        "issuedAt": { "$ref": "./common.schema.json#/$defs/UtcInstant" },
        "notBefore": { "$ref": "./common.schema.json#/$defs/UtcInstant" },
        "expiresAt": { "$ref": "./common.schema.json#/$defs/UtcInstant" },
        "nonceHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "consentEnvelopeHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "proof": { "$ref": "#/$defs/ConsentInstallationProof" }
      }
    }
  }
}
