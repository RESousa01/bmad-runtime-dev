{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sapphirus.dev/v1/bmad-review-result.schema.json",
  "title": "sapphirus.bmad-review-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "lens", "targetKind", "targetHash", "deterministicFindings", "modelFindings", "verification", "disposition", "resultHash"],
  "properties": {
    "schemaVersion": { "const": "sapphirus.bmad-review-result.v1" },
    "reviewId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "lens": { "enum": ["security", "quality", "architecture", "completeness", "evidence_gap", "eval_readiness"] },
    "targetKind": { "enum": ["artifact", "skill", "module", "workflow", "code_change", "completion_evidence"] },
    "targetHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
    "deterministicFindings": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/Finding" } },
    "modelFindings": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/Finding" } },
    "verification": { "$ref": "#/$defs/Verification" },
    "disposition": { "enum": ["passed", "advisory", "blocked"] },
    "resultHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
  },
  "$defs": {
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "origin", "severity", "code", "evidence", "verificationState"],
      "properties": {
        "findingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$" },
        "origin": { "enum": ["deterministic", "model"] },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$" },
        "evidence": { "$ref": "#/$defs/EvidenceLocation" },
        "verificationState": { "enum": ["unverified", "verified", "refuted"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "EvidenceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "contentHash"],
      "properties": {
        "locator": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$" },
        "contentHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "line": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "Verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEvidence", "presentEvidence", "gapsBlockCompletion"],
      "properties": {
        "requiredEvidence": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$" } },
        "presentEvidence": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_]*$" } },
        "gapsBlockCompletion": { "type": "boolean" }
      }
    }
  }
}
