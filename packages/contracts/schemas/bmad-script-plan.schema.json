{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sapphirus.dev/v1/bmad-script-plan.schema.json",
  "title": "sapphirus.bmad-script-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "sourceScriptHash", "steps", "authorityDecisionId", "planHash"],
  "properties": {
    "schemaVersion": { "const": "sapphirus.bmad-script-plan.v1" },
    "planId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "sourceScriptHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/PlanStep" }
    },
    "authorityDecisionId": { "$ref": "./common.schema.json#/$defs/ContractId" },
    "planHash": { "$ref": "./common.schema.json#/$defs/Sha256" }
  },
  "$defs": {
    "PlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "operation", "argumentsHash", "approval"],
      "properties": {
        "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" },
        "operation": { "enum": ["read_file", "write_file", "create_directory", "run_process", "network_request", "emit_artifact"] },
        "argumentsHash": { "$ref": "./common.schema.json#/$defs/Sha256" },
        "approval": { "enum": ["not_required", "required", "granted", "denied"] }
      }
    }
  }
}
