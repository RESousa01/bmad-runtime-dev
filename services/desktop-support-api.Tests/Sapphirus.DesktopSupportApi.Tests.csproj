<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../desktop-support-api/Sapphirus.DesktopSupportApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../packages/contracts/fixtures/valid/model-context-consent.json"
             Link="ContractFixtures/model-context-consent.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../packages/contracts/fixtures/valid/model-access-receipt.json"
             Link="ContractFixtures/model-access-receipt.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!--
      The canonical raw Foundry response shapes. Discovery is proved against
      these exact bodies, so a fixture change breaks the tests instead of
      quietly diverging from what the fake server serves.
    -->
    <Content Include="../../tools/foundry-fake/fixtures/foundry-fixtures.v1.json"
             Link="ContractFixtures/foundry-fixtures.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
