{
  "name": "forge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Forge governed, local-authority AI workspace for Windows.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @forge/desktop-ui dev",
    "build": "pnpm contracts:check:typescript && pnpm --filter @forge/desktop-ui build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "contracts:generate:cross-language": "pnpm --filter @sapphirus/contracts generate",
    "contracts:check:typescript": "pnpm --filter @sapphirus/contracts check:typescript",
    "contracts:verify:typescript": "pnpm --filter @sapphirus/contracts verify:typescript",
    "contracts:verify:cross-language": "pnpm --filter @sapphirus/contracts verify:cross-language",
    "contracts:test": "pnpm --filter @sapphirus/contracts test",
    "bmad:foundation:verify": "pnpm --filter @sapphirus/bmad-foundation run verify",
    "bmad:coverage": "node tools/check-bmad-coverage.mjs --check",
    "bmad:coverage:test": "node --test tools/check-bmad-coverage.test.mjs",
    "secrets:check": "node --test tools/check-secrets.test.mjs && node tools/check-secrets.mjs",
    "release:test": "node --test tools/release-metadata.test.mjs tools/release-sbom.test.mjs tools/release-attestation-predicate.test.mjs",
    "release:metadata": "node tools/resolve-release-metadata.mjs",
    "release:sbom": "node tools/generate-release-sbom.mjs",
    "vault:test": "node --test tools/tests/closed-manifest.test.mjs",
    "vault:check": "node tools/verify-reference-vault.mjs",
    "rust:fmt": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "rust:test": "cargo test --workspace --all-features --locked",
    "desktop:dev": "pnpm exec tauri dev --config crates/desktop-app/tauri.conf.json --features direct-model-providers",
    "desktop:dev:deterministic": "pnpm exec tauri dev --config crates/desktop-app/tauri.conf.json --features deterministic-help",
    "local:up": "docker compose -f infra/local/compose.yaml up --detach --build --wait",
    "local:down": "docker compose -f infra/local/compose.yaml down",
    "local:contracts:test": "node --test tools/forge-local.test.mjs",
    "support:cloud-contracts:test": "node --test tools/support-cloud-contracts.test.mjs",
    "desktop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/start-forge-local.ps1",
    "desktop:build": "pnpm exec tauri build --config crates/desktop-app/tauri.conf.json --features deterministic-help",
    "desktop:build:direct": "pnpm exec tauri build --config crates/desktop-app/tauri.conf.json --features direct-model-providers",
    "verify:boundaries": "node tools/check-boundaries.mjs",
    "boundaries:test": "node --test tools/check-boundaries.test.mjs",
    "css:conflicts": "node tools/check-css-conflicts.mjs",
    "css:conflicts:test": "node --test tools/check-css-conflicts.test.mjs",
    "brand:test": "node --test tools/forge-brand.test.mjs",
    "ci:policy:test": "node --test tools/check-workflows.test.mjs tools/check-workflows-exist.test.mjs",
    "ci:reachable": "node tools/check-workflows.mjs",
    "readiness:check": "node tools/check-readiness-scorecard.mjs",
    "readiness:test": "node --test tools/check-readiness-scorecard.test.mjs",
    "toolchain:check": "node tools/check-toolchain.mjs",
    "verify:source": "pnpm toolchain:check && pnpm ci:policy:test && pnpm ci:reachable && pnpm boundaries:test && pnpm brand:test && pnpm css:conflicts:test && pnpm local:contracts:test && pnpm support:cloud-contracts:test && pnpm bmad:foundation:verify && pnpm bmad:coverage && pnpm bmad:coverage:test && pnpm contracts:verify:typescript && pnpm secrets:check && pnpm release:test && pnpm typecheck && pnpm lint && pnpm test && pnpm verify:boundaries && pnpm css:conflicts && pnpm build",
    "verify": "pnpm verify:source",
    "verify:deferred-full": "pnpm contracts:verify:cross-language && pnpm secrets:check && pnpm typecheck && pnpm lint && pnpm test && pnpm verify:boundaries && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test && pnpm build"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "typescript": "7.0.2"
  }
}
