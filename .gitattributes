* text=auto eol=lf
# Pinned upstream source is retained byte-for-byte for provenance verification.
packages/bmad-foundation/source/** -text
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf
*.slnx text eol=lf
# Installer sources that NSIS reads on Windows. The license page in
# particular is a rich-text control: a file checked out with lone LFs renders
# as one unbroken line.
*.nsh text eol=crlf
crates/desktop-app/installer/LICENSE.txt text eol=crlf
*.png binary
*.bmp binary
*.ico binary
*.db binary
*.sqlite binary
tools/contract-codegen/vendor/*.exe filter=lfs diff=lfs merge=lfs -text
